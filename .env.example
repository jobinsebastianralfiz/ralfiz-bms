# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#   cp .env.example .env

# ── Django ──────────────────────────────────────────────────────────
# SECRET_KEY=
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset locally to use the SQLite dev database.
# Railway injects it in production (PostgreSQL).
# DATABASE_URL=

# ── PULSE command center ────────────────────────────────────────────
# Required for /api/pulse/ask/ to answer. Without it the endpoint
# returns 503 with a clear message rather than failing obscurely.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-4-8.
# PULSE_MODEL=claude-opus-4-8

# ── PULSE document search (NOT YET BUILT) ───────────────────────────
# Anthropic has no embeddings endpoint, so document search needs a
# separate provider. Voyage gives 200M free tokens on voyage-4.
# Get one at https://dashboard.voyageai.com
VOYAGE_API_KEY=
# PULSE_EMBEDDING_MODEL=voyage-4

# ── Weather (NOT YET BUILT) ─────────────────────────────────────────
# Use the free "Current Weather Data" plan -- no payment card needed.
# Do NOT use One Call 3.0: it requires a card on file.
# Get one at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ── Push notifications (optional) ───────────────────────────────────
# FIREBASE_CREDENTIALS_PATH=
