<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Campus Help Desk plug-in project (lesson D.9).
    Same settings that "pac plugin init" creates in a folder named ChdPlugins:
    .NET Framework 4.6.2, a strong-name key (ChdPlugins.snk) and the Dataverse SDK.
    Keep the ChdPlugins.snk file that pac plugin init generated next to this file.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>ChdPlugins</RootNamespace>
    <AssemblyName>ChdPlugins</AssemblyName>
    <LangVersion>latest</LangVersion>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ChdPlugins.snk</AssemblyOriginatorKeyFile>
    <!-- Change the version each time you update the assembly in Dataverse -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ProjectTypeGuids>{4C25E9B5-9FA6-436c-8E19-B395D2A65FAF};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
  </PropertyGroup>

  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.props" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.props')" />

  <ItemGroup>
    <!-- Dataverse SDK: IPlugin, Entity, OptionSetValue, ITracingService ... -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <!-- Lets "dotnet build" compile net462 on machines without Visual Studio -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Plugin" Version="1.*" PrivateAssets="All" />
  </ItemGroup>

  <Import Project="$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.targets" Condition="Exists('$(PowerAppsTargetsPath)\Microsoft.PowerApps.VisualStudio.Plugin.targets')" />
</Project>