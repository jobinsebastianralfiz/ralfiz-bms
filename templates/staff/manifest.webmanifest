{% load static %}{
  "name": "Ralfiz Staff",
  "short_name": "Ralfiz",
  "description": "Attendance, leave, work and classes for Ralfiz interns and employees.",
  "start_url": "/staff/",
  "scope": "/staff/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#05090b",
  "theme_color": "#05090b",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "{% static 'staff/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'staff/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'staff/icon-maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Attendance", "url": "/staff/attendance/" },
    { "name": "Leave", "url": "/staff/leave/" },
    { "name": "Work", "url": "/staff/work/" }
  ]
}
